# Created by Gemini for a professional MATLAB project

# -------------------------------------------------------------------
# MATLAB & Simulink specific ignores
# -------------------------------------------------------------------
# MATLAB auto-save files
*.asv

# MATLAB P-code files (pre-parsed executable)
*.p

# MATLAB compiled MEX files (platform specific)
*.mex*

# MATLAB App Installer files
*.mlappinstall

# MATLAB session backup files
*.matlabsession

# Simulink auto-generated files and caches
*.slxc
*.slx.r*
*.slddc
*.sltx
*resources
*.orig
*.slprj/

# -------------------------------------------------------------------
# Application-Specific Ignores (Logs, Caches, Outputs)
# -------------------------------------------------------------------
# Ignore all log files
*.log

# Ignore the test reports folder generated by the CI script
test-results/

# Ignore .mat cache files specifically inside any folder named 'cache'
# This is a powerful rule that protects all your caches but allows other .mat files.
**/cache/*.mat

# Ignore specific, known cache files in the root or other directories
aga_url_cache.mat
cachedMarketData.mat
GlobalMortalityTableCache.mat

# Ignore the Output folder for generated results
Output/

# -------------------------------------------------------------------
# Temporary Files from Other Software
# -------------------------------------------------------------------
# Microsoft Office temporary lock files
~$*.*

# Google Drive proprietary shortcut files (prevents fatal git errors)
# The [gG] syntax makes the rule case-insensitive.
*.[gG][dD][oO][cC]
*.[gG][sS][hH][eE][eE][tT]
*.[gG][sS][lL][iI][dD][eE][sS]
*.[gG][dD][rA][aW][w]
*.[gG][fF][oO][rR][mM]
*.[gG][mM][aA][pP]
*.[gG][sS][iI][tT][eE]

# -------------------------------------------------------------------
# MATLAB Project & Environment Files (Optional but Recommended)
# -------------------------------------------------------------------
# Ignore user-specific project files
*.prj.user
*.slprj.user

